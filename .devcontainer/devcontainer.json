{
  "name": "Marginalia local development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {"version": "3.12"},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm run setup && npx --no-install playwright install --with-deps chromium",
  "waitFor": "postCreateCommand",
  "forwardPorts": [5173, 8788],
  "portsAttributes": {
    "5173": {"label": "Reader", "onAutoForward": "notify"},
    "8788": {"label": "Local audiobook fixtures", "onAutoForward": "silent"}
  },
  "remoteEnv": {"PATH": "${containerWorkspaceFolder}/tools/narrate/.quality-venv/bin:${containerEnv:PATH}"}
}
