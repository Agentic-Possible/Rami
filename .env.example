# Optional, public SDK identifiers. No telemetry starts without reader consent.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
CHAT_ENABLED=true
# Optional: reading works without a key; local /api/chat returns 503 without one.
# Copy to .env.local and supply your own key. Never commit the populated file.
OPENROUTER_API_KEY=
